# Zkopírujte tenhle soubor jako .env.local a doplňte hodnoty.
# .env.local je v .gitignore, takže se nikam nenahraje.

# ── Administrace (/admin) ─────────────────────────────────────────
# Bez hesla je administrace vypnutá. Zvolte si vlastní, ať je delší.
ADMIN_PASSWORD=
# Nepovinné: přidá se k podpisu přihlašovací cookie. Když ho změníte,
# všichni přihlášení se odhlásí.
ADMIN_SECRET=

# ── Databáze obsahu (Supabase) ────────────────────────────────────
# Project Settings → Data API → Project URL:
#   SUPABASE_URL = https://<id-projektu>.supabase.co
#
# Project Settings → API Keys → sekce "Secret keys" → klíč sb_secret_…
#   SUPABASE_SECRET_KEY = ten tajný, NE publishable
#
# Pozn.: starší projekty mají místo toho service_role klíč (začíná na eyJ).
# Ten funguje taky — dá se vložit sem, nebo do SUPABASE_SERVICE_ROLE_KEY.
#
# Tajný klíč obchází pravidla přístupu, takže patří JEN sem na server.
# Nikdy mu nedávejte předponu NEXT_PUBLIC_ a nikdy ho nedávejte do kódu.
#
# Když tyhle dvě proměnné chybí, obsah se ukládá do souboru
# content/site.json. To stačí na vývoj u sebe, ale na Vercelu to
# nefunguje — tam je disk jen pro čtení.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ── Odesílání kontaktního formuláře přes Resend ───────────────────
# https://resend.com — bez klíče se zpráva jen zaloguje na serveru.
RESEND_API_KEY=
# Kam mají poptávky chodit (výchozí: e-mail z administrace)
CONTACT_TO=
# Odesílatel – ověřená doména v Resend, nebo onboarding@resend.dev na zkoušku
CONTACT_FROM=LanoDigital <onboarding@resend.dev>
